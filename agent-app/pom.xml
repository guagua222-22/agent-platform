<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.agentplatform</groupId>
        <artifactId>agent-platform</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>agent-app</artifactId>
    <name>agent-app</name>
    <description>Spring Boot 壳 + REST/SSE API + 示例 Agent 装配</description>

    <dependencies>
        <dependency>
            <groupId>com.agentplatform</groupId>
            <artifactId>agent-harness</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
            模型接入：OpenAI 兼容协议适配器。
            为什么用 OpenAI starter 而不是供应商专属 starter：DashScope（千问）、DeepSeek 等
            国内主流平台都提供 OpenAI 兼容端点，协议同源；ReActLoop 只依赖 ChatModel 抽象，
            换供应商只改 yml 的 base-url/key，零代码改动——这就是模型网关可插拔的基础。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!--
            持久化三件套：
            starter-jdbc 提供 DataSource/JdbcTemplate 自动配置；
            mysql-connector-j 是驱动（runtime scope，不传递到依赖方编译期）；
            flyway-core + flyway-mysql 做版本化数据库迁移（生产级 schema 变更基线）。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <!-- Redis 连接与 StringRedisTemplate 自动配置（Checkpoint/限流的数据底座） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
        <!--
            生产级底线：应用一启动就要有 health/metrics 探针。
            M4 会在此之上加 Token 成本、首 token 延迟等 Agent 专属指标。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
